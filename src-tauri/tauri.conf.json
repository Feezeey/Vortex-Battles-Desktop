{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vortex Battles",
  "version": "0.1.0",
  "identifier": "de.vortexbattles.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vortex Battles",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "fullscreen": true,
        "resizable": true,
        "backgroundColor": "#0b1527"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhERTFGRTgyNzVENjBFRUQKUldUdER0WjFndjdoalRJQ3BHcHJtaDRHckUwKzl5MmVnZmFtSHU3Z2FCckxsaHJhY1pwSU1FODAK",
      "endpoints": [
        "https://github.com/Feezeey/vortex-battles-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
